# L'analyse passe par Claude Code (abonnement) : `claude` doit être connecté en local,
# ou CLAUDE_CODE_OAUTH_TOKEN (claude setup-token) en CI. Aucune clé API nécessaire.

# Gmail : IMAP activé + mot de passe d'application (https://myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
NEWSLETTER_FROM=                # vide = liste par défaut (voir README), sinon motif1,motif2

# On-chain : wallet DÉDIÉ à faible solde, jamais ton wallet principal
PK_AGENT=                       # clé du wallet agent (hunt --execute)
MAX_TX_USD=25
MAX_DAY_USD=50
HYPE_BUDGET_USD=50              # plafond total en HYPE staké sur Hyperliquid
WATCH_WALLETS=                  # adresses PUBLIQUES à vérifier : main:0x…,sol:7xK…
PK_MAIN=                        # clé privée du compte "main" de accounts.json
RPC_BASE=https://mainnet.base.org
RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
ALLOWED_CONTRACTS=              # contrats vérifiés à la main, séparés par des virgules
MAX_TX_ETH=0.01
